{
  "name": "relay",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter \"./packages/*\" build && pnpm --filter \"./apps/*\" build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "audit": "pnpm audit --audit-level moderate",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "db:migrate": "pnpm --filter @relay/api db:migrate",
    "db:seed": "pnpm --filter @relay/api db:seed",
    "db:studio": "pnpm --filter @relay/api db:studio",
    "postinstall": "pnpm --filter @relay/api exec node scripts/ensure-prisma-client.mjs",
    "free-port": "node scripts/free-port.mjs",
    "e2e": "pnpm --filter @relay/api db:clear-messages && pnpm --filter @relay/e2e e2e",
    "e2e:ui": "pnpm --filter @relay/e2e e2e:ui",
    "e2e:report": "pnpm --filter @relay/e2e e2e:report"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.0"
  }
}
