{
  "name": "@relay/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/ensure-prisma-client.mjs && nest start --watch",
    "build": "node scripts/ensure-prisma-client.mjs && nest build",
    "start": "node dist/main.js",
    "typecheck": "node scripts/ensure-prisma-client.mjs && tsc -p tsconfig.json --noEmit",
    "test": "node scripts/ensure-prisma-client.mjs && vitest run",
    "test:watch": "node scripts/ensure-prisma-client.mjs && vitest",
    "test:coverage": "node scripts/ensure-prisma-client.mjs && vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/platform-socket.io": "^11.1.6",
    "@nestjs/websockets": "^11.1.6",
    "@node-rs/argon2": "^2.1.0",
    "@prisma/client": "^6.19.3",
    "@relay/shared": "workspace:*",
    "prisma": "^6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.19",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.1.4",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.5.7",
    "vitest": "^3.2.4"
  }
}
