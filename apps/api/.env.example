# Servidor
PORT=4000
WEB_ORIGIN=http://localhost:3000

# Base de datos — coincide con docker-compose.yml en la raíz
DATABASE_URL=postgresql://relay:relay@localhost:5432/relay?schema=public

# Auth (fase 1). En local cualquier cadena larga sirve; en despliegue, secretos reales.
JWT_ACCESS_SECRET=reemplaza-esto-por-32-caracteres-o-mas-en-serio
JWT_REFRESH_SECRET=y-esto-por-otro-distinto-de-32-caracteres-o-mas
